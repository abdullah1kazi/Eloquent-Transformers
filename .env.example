# Application
APP_NAME=Eloquent Transformers
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://eloquent:eloquent_password@localhost:5432/eloquent_transformers

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_PATH=./storage/audio
MAX_UPLOAD_SIZE=104857600  # 100MB

# ML Models
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu  # or cuda for GPU

# Vector Database
CHROMA_PERSIST_DIR=./storage/chroma

# API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=true
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60
